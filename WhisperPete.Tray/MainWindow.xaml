<Window x:Class="WhisperPete.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhisperPete" SizeToContent="Height" Width="450" MinWidth="450" MinHeight="250"
        Visibility="Hidden" WindowState="Minimized" ShowInTaskbar="False" ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <StackPanel>
                <TextBlock Text="Whisper Transcription" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <GroupBox Header="Model Configuration" Margin="0,5">
                    <StackPanel Margin="5">
                        <Button x:Name="BtnSelectModel" Content="Select ONNX Model..." Click="BtnSelectModel_Click" Height="30"/>
                        <TextBlock x:Name="TxtModelPath" Text="No model loaded." TextWrapping="Wrap" FontSize="10" Foreground="Gray" Margin="0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Compute Device: " Foreground="Gray"/>
                            <TextBlock x:Name="TxtAccelerator" Text="None" Foreground="#00BCD4" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <Button x:Name="BtnRecord" Content="Start Recording" Click="BtnRecord_Click" Height="40" Margin="0,5"/>
                <TextBlock Text="Status: " Name="TxtStatus" Margin="0,5"/>
                <TextBox x:Name="TxtResult" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,5" IsReadOnly="True" MinHeight="60"/>

                <GroupBox Header="Options" Margin="0,5">
                    <StackPanel Margin="5">
                        <CheckBox x:Name="ChkSaveDebug" Content="Save debug audio recordings" IsChecked="True" Checked="ChkSaveDebug_Changed" Unchecked="ChkSaveDebug_Changed" Margin="0,2"/>
                        <CheckBox x:Name="ChkStartWithWindows" Content="Start WhisperPete with Windows" Checked="ChkStartWithWindows_Changed" Unchecked="ChkStartWithWindows_Changed" Margin="0,2"/>
                        
                        <Separator Margin="0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Global Hotkey: " Foreground="Gray"/>
                            <TextBlock Text="Ctrl + Alt + W" FontWeight="Bold" Foreground="#00BCD4"/>
                        </StackPanel>
                        <TextBlock Text="(Editable in future updates)" FontSize="9" Foreground="Gray" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
