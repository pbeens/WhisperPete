{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperPete",
  "version": "1.0.1",
  "identifier": "com.whisperpete.app",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "WhisperPete", "width": 560, "height": 420, "minWidth": 420, "minHeight": 320, "visible": true, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
